{
	"schemaVersion": 1,
	"id": "nearbycrafting",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "Allows the crafting table to access nearby chests or other containers, because that's how it should be!",
	"authors": [
		"Jomlom"
	],
	"contact": {
		"sources": "https://github.com/Jomlom/Nearby-Crafting"
	},
	"license": "MIT",
	"icon": "assets/nearbycrafting/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jomlom.nearbycrafting.fabric.NearbyCraftingFabric"
		],
		"client": [
			"com.jomlom.nearbycrafting.fabric.NearbyCraftingFabricClient"
		],
		"modmenu": [
			"com.jomlom.nearbycrafting.clientUtil.ModMenuIntegration"
		]
	},
	"mixins": [
		"nearbycrafting.mixins.json",
		"nearbycrafting.farmersdelight.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2 <=26.2",
		"java": ">=25",
		"fabric-api": "*",
		"recipebookaccess": ">=1.3.1",
		"modmenu": ">=18.0.0"
	}
}
